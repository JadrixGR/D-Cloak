ENVIRONMENT=development
DATABASE_URL=sqlite:///./novashield.db
JWT_SECRET=replace-with-at-least-32-random-characters
PROFILE_DATA_KEY=replace-with-a-different-random-secret
ADMIN_EMAIL=admin@novashield.app
ADMIN_NAME=Nova Admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
DEFAULT_SERVER_IP=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_PRIVATE_PROXIES=false
BROWSER_PROVIDER=disabled
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=us-east-1
BROWSER_SESSION_TIMEOUT_SECONDS=3600
AUTO_CREATE_SCHEMA=true
